# ==============================================================================
# BakeryOps AI — Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NOTE: Never commit .env.local, API keys, or private auth tokens to source control.
# ==============================================================================

# Switch Core Server URL
# The origin where Switch Console serves the Matrix message bus and agent API.
# Defaults to http://localhost:61364/ when running Switch Console locally.
SWITCH_CORE_URL=http://localhost:61364/

# Application Server Port (Optional, defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Optional Multi-Agent Switch Identifiers
# ------------------------------------------------------------------------------
# When importing template.yaml into a new Switch instance, Switch assigns new
# UUIDs to the agents and the room. You can optionally set them below to override
# the default local configuration:

# SWITCH_OPERATIONS_ROOM_ID=
# SWITCH_ORDER_ANALYST_ID=
# SWITCH_PRODUCTION_PLANNER_ID=
# SWITCH_INVENTORY_MANAGER_ID=
# SWITCH_STAFF_TASK_ASSIGNER_ID=
