data/*.sqlite
data/*.sqlite-*
data/*.sqlite.*
data/*.db
data/*.db-*
data/*.db.*

# Logs and runtime traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup archives
*.zip
*.tar.gz

# Test reports
test-results/
playwright-report/
coverage/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Switch runtime artifacts
.switch/
